# Arch Linux, Manjaro, EndeavourOS: makepkg -si
# Instala el binario oficial de la versión publicada en GitHub.
pkgname=quantum-daw-bin
pkgver=@VERSION@
pkgrel=1
pkgdesc="Estación de audio digital moderna escrita en Rust"
arch=('x86_64')
url="https://www.quantumdaw.com"
license=('MPL-2.0')
depends=('alsa-lib' 'glibc' 'gcc-libs')
optdepends=('ffmpeg: importar video'
            '7zip: instrumentos descargables en 7z'
            'curl: descargar instrumentos'
            'pipewire: nombres de los dispositivos de audio')
provides=('quantum-daw')
conflicts=('quantum-daw')
source=("quantum-daw-$pkgver.tar.gz::https://github.com/quantexpy69/quantumdaw/releases/download/v$pkgver/quantum-daw-linux-x86_64.tar.gz")
sha256sums=('@SHA256@')

package() {
  cd "quantum-daw-$pkgver"
  install -Dm755 quantum-daw "$pkgdir/usr/bin/quantum-daw"
  install -Dm644 quantum-daw.desktop "$pkgdir/usr/share/applications/quantum-daw.desktop"
  install -Dm644 quantum-daw.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/quantum-daw.svg"
  install -Dm644 com.quantumdaw.QuantumDAW.metainfo.xml "$pkgdir/usr/share/metainfo/com.quantumdaw.QuantumDAW.metainfo.xml"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
